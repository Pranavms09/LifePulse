# Google Gemini API Key (used by ALL AI features)
# Powers: Sanjeevani AI, Pregnancy AI, Medicine Analyzer
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Instructions:
# 1. Copy: cp .env.example .env
# 2. Fill in your real Gemini API key in .env
# 3. For Vercel: Settings > Environment Variables > add GEMINI_API_KEY
